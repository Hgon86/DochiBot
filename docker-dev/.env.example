# DochiBot 개발 환경 변수 예시
# docker-dev/compose.yaml과 src/main/resources/application.yml의 기본값을 오버라이드한다.
# 실제 사용 시 이 파일을 복사해 .env로 만들거나 셸 환경변수로 주입한다.
# (docker compose는 자동으로 같은 디렉토리의 .env를 읽는다)

# --- PostgreSQL ---
POSTGRES_USER=dochibot
POSTGRES_PASSWORD=dochibot123
POSTGRES_DB=dochi_bot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (운영 시 반드시 32바이트 이상 시크릿 주입) ---
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=43200
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ISSUER_URI=

# --- OAuth2 (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_BACKEND_BASE_URL=http://localhost:8080
OAUTH2_FRONTEND_BASE_URL=http://localhost:5173

# --- AI (Ollama / OpenAI 호환) ---
AI_CHAT_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_DIMS=1024
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct

# --- S3 (SeaweedFS) ---
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=dochi-bot
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3secret
S3_PATH_STYLE_ACCESS=true

# --- CORS / Cookie ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# --- Cross-Encoder (선택 프로필) ---
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
CROSS_ENCODER_API_KEY=

# --- RAG 튜닝 (선택; 기본값은 application.yml 참고) ---
# DOCHIBOT_RAG_RERANK_ENABLED=true
# DOCHIBOT_RAG_RERANK_MODEL=HEURISTIC
# DOCHIBOT_RAG_VERIFY_ENABLED=false
# DOCHIBOT_RAG_VERIFY_POLICY=NO_EVIDENCE
